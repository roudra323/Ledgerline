# ─────────────────────────────────────────────────────────────
# ChainStake environment. Copy to `.env` and adjust as needed.
# `.env` is git-ignored; only this example is committed.
# ─────────────────────────────────────────────────────────────

# ── Chain / RPC ──────────────────────────────────────────────
CHAIN_ID=31337
RPC_URL_PRIMARY=http://anvil:8545
RPC_URL_FALLBACK=http://anvil2:8545
CONFIRMATIONS=3
# Deterministic Anvil dev mnemonic (NEVER use with real funds)
DEV_MNEMONIC="test test test test test test test test test test test junk"

# ── Contract addresses (written by the deployer at chain boot) ─
STAKING_VAULT_ADDRESS=
MOCK_TOKEN_ADDRESS=
DEPLOY_BLOCK=0

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=chainstake
POSTGRES_PASSWORD=chainstake
POSTGRES_DB=chainstake
DATABASE_URL=postgresql://chainstake:chainstake@postgres:5432/chainstake

# ── Indexer ──────────────────────────────────────────────────
INDEXER_PORT=3001
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_START_CHUNK_SIZE=2000
LOG_LEVEL=info

# ── Observability ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=chainstake-indexer
DEPLOYMENT_ENVIRONMENT=local

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_CHAIN_ID=31337

# ── Alerting ─────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
