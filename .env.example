# ─────────────────────────────────────────────────────────────
# Ledgerline environment. Copy to `.env` and adjust as needed.
# `.env` is git-ignored; only this example is committed.
# ─────────────────────────────────────────────────────────────

# ── Chain / RPC ──────────────────────────────────────────────
CHAIN_ID=31337
RPC_URL_PRIMARY=http://anvil:8545
RPC_URL_FALLBACK=http://anvil2:8545
# Deterministic Anvil dev mnemonic (NEVER use with real funds)
DEV_MNEMONIC="test test test test test test test test test test test junk"

# ── Confirmation depth is a RISK BUDGET, not a constant ──────
# Spend it where the irreversibility is. A settlement can be rolled back by a compensating
# posting; a fiat payout cannot. See docs/decisions/0007-events-not-receipts.md.
CONFIRMATIONS_INGEST=3
CONFIRMATIONS_SETTLE=2
CONFIRMATIONS_PAYOUT_BURN=4

# ── Contract addresses (written by the deployer at chain boot) ─
STABLE_USD_ADDRESS=
PAYMENT_PROCESSOR_ADDRESS=
DEPLOY_BLOCK=0

# ── Signing keys ─────────────────────────────────────────────
# WELL-KNOWN PUBLIC ANVIL TEST KEYS — worthless, published in the Foundry docs, NEVER reuse.
# LocalDevSigner refuses to start unless NODE_ENV != production AND CHAIN_ID == 31337.
# Three segregated roles, three keys — the structure is right even though the storage is not.
# See docs/decisions/0011-key-management.md.
SIGNER_ADAPTER=local
TREASURY_MINTER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
HOT_PAYOUT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
GAS_FUNDER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Signing policy caps (SigningPolicyService denies and audits before any signature)
POLICY_MAX_VALUE_PER_TX_MINOR=100000000
POLICY_MAX_VALUE_PER_HOUR_MINOR=1000000000

# ── Chain writer ─────────────────────────────────────────────
CHAIN_TX_STUCK_AFTER_MS=60000
CHAIN_TX_BASE_FEE_MULTIPLIER=2
CHAIN_TX_FEE_BUMP_FACTOR=1.25
CHAIN_TX_MAX_FEE_CEILING_WEI=500000000000
GAS_BALANCE_FLOOR_WEI=50000000000000000

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ledgerline
POSTGRES_PASSWORD=ledgerline
POSTGRES_DB=ledgerline
DATABASE_URL=postgresql://ledgerline:ledgerline@localhost:5433/ledgerline
# Least-privilege role the RUNNING APP connects as (Block 1.5). Created by the
# LedgerImmutability migration, which also revokes UPDATE/DELETE on ledger_entries and
# ledger_transactions from it. DATABASE_URL above (the table owner) is for the migration CLI only.
APP_DATABASE_URL=postgresql://ledgerline_app:ledgerline_app@localhost:5433/ledgerline

# ── Indexer ──────────────────────────────────────────────────
INDEXER_PORT=3001
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_START_CHUNK_SIZE=2000
LOG_LEVEL=info

# ── Payment rail (PSP) ───────────────────────────────────────
PSP_PROVIDER=mockpsp
PSP_BASE_URL=http://mock-psp:4001
# HMAC secret for webhook signature verification (raw body, constant-time compare, ±5min window)
PSP_WEBHOOK_SECRET=dev-webhook-secret-not-a-real-one
PSP_POLL_INTERVAL_MS=3600000
CAPTURE_AMOUNT_TOLERANCE_BPS=10
REFUND_WINDOW_DAYS=120
QUOTE_TTL_SECONDS=900

# Stripe adapter (Phase 12). Left empty by default — the mock is the CI path.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Outbox ───────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8

# ── Treasury / liquidity (ADR-0013: settlement transfers from a FINITE treasury) ─
TREASURY_FLOAT_MIN_MINOR=100000000
TREASURY_FLOAT_TARGET_MINOR=500000000
TREASURY_FLOAT_MAX_MINOR=2000000000
INITIAL_MINTER_ALLOWANCE_MINOR=10000000000

# ── Compliance (fails CLOSED — never credit on an unavailable result) ─
SCREENING_ENABLED=true
SCREENING_FAIL_MODE=closed
OFAC_SDN_SNAPSHOT_PATH=./data/ofac-sdn.pinned.json
CHAIN_RISK_ADAPTER=mock

# ── Observability ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=ledgerline-indexer
DEPLOYMENT_ENVIRONMENT=local

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MOCK_PSP_URL=http://localhost:4001
NEXT_PUBLIC_CHAIN_ID=31337

# ── Alerting ─────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
